# Copia este archivo a .env (o define las variables en tu hosting)
DEBUG=1
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# En producción: postgres://usuario:clave@host:5432/boletacl
# DATABASE_URL=
# CSRF_TRUSTED_ORIGINS=https://boletacl.com
# Email para recuperar contraseña (opcional; sin esto se imprimen en consola)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=EmiteBoleta <tu-correo@gmail.com>
